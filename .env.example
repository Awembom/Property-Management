# Copy this file to `.env` and fill in the real values.
# Find them in the Supabase dashboard: Project Settings -> API (or "API Keys").
# NEVER put the service_role / secret key here: this file is bundled into the app.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
